# Gateway — draft for the future `commutr-gateway` repo.
# Rendered by the nginx image's envsubst (see Dockerfile NGINX_ENVSUBST_FILTER).
#
# PHASE 2 (current): "/" -> ets-web, no /ets/ /crd/ blocks. No user-visible change.
# PHASE 3: switch "/" to launcher, enable the /ets/ block (see comments below).
# PHASE 4: enable the /crd/ and /crd-api/ blocks.

server {
    listen 80 default_server;
    server_name _;

    resolver 8.8.8.8 ipv6=off valid=30s;

    # TODO: set to the value the current ETS nginx uses (uploads: Excel/documents)
    client_max_body_size 50m;

    location = /healthz {
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # ── Auth APIs ──
    location ~ ^/api/v1/(Auth|me|refresh-token|Users/reset-password|Users/check-exists|Users/change-password) {
        set $auth https://${AUTH_HOST};
        proxy_pass $auth;
        proxy_ssl_server_name on;
        proxy_set_header Host ${AUTH_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ── SignalR (WebSocket) — route-tracking hub on EtsCore ──
    # Requires VITE_API_BASE_URL_SIGNALR="" so the client uses /hubs/... same-origin.
    location /hubs/ {
        set $core https://${CORE_HOST};
        proxy_pass $core;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_ssl_server_name on;
        proxy_set_header Host ${CORE_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # ── ETS core APIs ──
    location /api/ {
        set $core https://${CORE_HOST};
        proxy_pass $core;
        proxy_ssl_server_name on;
        proxy_set_header Host ${CORE_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ── PHASE 3: enable these two, then point "/" at launcher ──
    # location = /ets { return 301 /ets/; }
    # location /ets/ {
    #     resolver 127.0.0.11 ipv6=off valid=10s;
    #     set $ets_web http://ets-web:80;
    #     proxy_pass $ets_web;
    #     proxy_set_header Host $host;
    # }

    # ── PHASE 4: CRD ──
    # location = /crd { return 301 /crd/; }
    # location /crd/ {
    #     resolver 127.0.0.11 ipv6=off valid=10s;
    #     set $crd_web http://crd-web:80;
    #     proxy_pass $crd_web;
    #     proxy_set_header Host $host;
    # }
    # location /crd-api/ {
    #     set $crd_api https://${CRD_HOST};
    #     rewrite ^/crd-api/(.*)$ /api/$1 break;
    #     proxy_pass $crd_api;
    #     proxy_ssl_server_name on;
    #     proxy_set_header Host ${CRD_HOST};
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # }

    # ── Fallback ──  PHASE 2: ets-web.  PHASE 3: change to launcher.
    location / {
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $default_app http://ets-web:80;
        proxy_pass $default_app;
        proxy_set_header Host $host;
    }
}
