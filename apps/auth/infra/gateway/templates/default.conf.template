# Gateway — rendered by the nginx image's envsubst (see Dockerfile NGINX_ENVSUBST_FILTER).
#
# "/"      -> launcher (login + app chooser)
# "/ets/"  -> ets-web
# "/crd/"  -> crd-web, "/crd-api/" -> CrdCore
# "/api/"  -> Auth / EtsCore APIs

server {
    listen 80 default_server;
    server_name _;

    resolver 8.8.8.8 ipv6=off valid=30s;

    # uploads: Excel/documents
    client_max_body_size 50m;

    # Upstreams are reached over HTTP/1.0 (nginx proxy default), so they never gzip.
    # Compress here instead, on the way out to the browser.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript text/javascript application/json image/svg+xml application/wasm;

    location = /healthz {
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # ── Auth APIs ──
    location ~ ^/api/v1/(Auth|me|refresh-token|Users/reset-password|Users/check-exists|Users/change-password) {
        set $auth https://${AUTH_HOST};
        proxy_pass $auth;
        proxy_ssl_server_name on;
        proxy_set_header Host ${AUTH_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ── SignalR (WebSocket) — route-tracking hub on EtsCore ──
    # Requires VITE_API_BASE_URL_SIGNALR="" so the client uses /hubs/... same-origin.
    location /hubs/ {
        set $core https://${CORE_HOST};
        proxy_pass $core;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_ssl_server_name on;
        proxy_set_header Host ${CORE_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # ── ETS core APIs ──
    location /api/ {
        set $core https://${CORE_HOST};
        proxy_pass $core;
        proxy_ssl_server_name on;
        proxy_set_header Host ${CORE_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ── ETS (served under /ets/) ──
    location = /ets { return 301 /ets/; }
    location /ets/ {
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $ets_web http://ets-web:80;
        proxy_pass $ets_web;
        proxy_set_header Host $host;
    }

    # ── CRD (served under /crd/) ──
    location = /crd { return 301 /crd/; }
    location /crd/ {
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $crd_web http://crd-web:80;
        proxy_pass $crd_web;
        proxy_set_header Host $host;
    }
    location /crd-api/ {
        set $crd_api https://${CRD_HOST};
        rewrite ^/crd-api/(.*)$ /api/$1 break;
        proxy_pass $crd_api;
        proxy_ssl_server_name on;
        proxy_set_header Host ${CRD_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ── Launcher at "/" ──
    location / {
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $default_app http://launcher:80;
        proxy_pass $default_app;
        proxy_set_header Host $host;
    }
}
