## 6 · Drag-and-Drop Architecture

**Hook:** `useDragAndDrop.ts` — completely isolated, no UI/business imports.

```typescript
// Key exports
type DropZoneType = "CAB_GROUP" | "ROUTE_CARD";
interface DragPassenger {
  passengerId: number;
  passengerName: string;
  employeeId: string;
  gender: "M" | "F";
  sourceVehicleId: number;
  sourceVehicleLabel: string;
  pickupSequence: number;
}
interface DropResult {
  passenger: DragPassenger;
  targetVehicleId: number;
  targetType: DropZoneType;
}
interface DragLogEntry {
  id;
  timestamp;
  action: "START" | "DROP" | "CANCEL" | "SAME_VEHICLE";
  passengerName;
  employeeId;
  fromVehicle;
  toVehicle;
  toType;
  success;
  note;
}
```

**Transfer key:** `'application/x-route-maker-passenger'`  
**Same-vehicle guard:** dropping on same `vehicleId` logs `SAME_VEHICLE` and returns `null`  
**Cancel detection:** `droppedRef.current` tracks successful drops; `onDragEnd` emits `CANCEL` if false  
**Logs:** capped at 100, newest first; `console.group()` with color formatting

**Zone IDs:**

- Left sidebar cab panel: `"cab-{vehicleId}"`
- Right stack card: `"route-card-{vehicleId}"`

**Passenger move logic** (in `RouteMakerPage.tsx`):

```typescript
function applyDropToCabGroup(result: DropResult): void {
  setCabGroups((prev) => {
    const from = prev.find(
      (g) => g.vehicleId === result.passenger.sourceVehicleId,
    );
    const to = prev.find((g) => g.vehicleId === result.targetVehicleId);
    if (!from || !to) return prev;
    const movedPassenger = from.passengers.find(
      (p) => p.Id === result.passenger.passengerId,
    );
    if (!movedPassenger) return prev;
    return prev.map((g) => {
      if (g.vehicleId === from.vehicleId)
        return {
          ...g,
          passengers: g.passengers.filter((p) => p.Id !== movedPassenger.Id),
        };
      if (g.vehicleId === to.vehicleId)
        return {
          ...g,
          passengers: [
            ...g.passengers,
            { ...movedPassenger, PickupSequence: g.passengers.length + 1 },
          ],
        };
      return g;
    });
  });
}
```

