{
  "name": "@commutr/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Commutr design system: tokens, antd theme, UI-library adapter and primitives shared by ETS, CRD and auth",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./theme": "./src/theme/antdTheme.ts",
    "./ui-lib": "./src/ui-lib/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./layout": "./src/layout/index.ts",
    "./styles/*": "./src/styles/*",
    "./api": "./src/api/index.ts",
    "./form": "./src/form/index.ts"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=6",
    "antd": ">=6",
    "react": ">=19",
    "react-dom": ">=19",
    "@reduxjs/toolkit": ">=2",
    "dayjs": ">=1",
    "react-phone-input-2": ">=2"
  }
}
